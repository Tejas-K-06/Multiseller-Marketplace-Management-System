POST {{base}}/reviews
Authorization: Bearer {{buyerLogin.response.body.$.data.token}}
Content-Type: application/json

{
  "orderId": {{checkout.response.body.$.data.orderId}},
  "productId": {{productCreate.response.body.$.data.productId}},
  "rating": 5,
